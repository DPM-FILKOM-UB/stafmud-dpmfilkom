{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "dpm-filkom/portal-aspirasi",
    "type": "project",
    "description": "Portal Aspirasi KBM FILKOM 2026 - Parlemen Cakrawala Mahardika DPM FILKOM UB",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
